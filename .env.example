# 로컬 실행용 환경변수 예시. 실제 값은 .env에 두고 커밋하지 않는다.
CONFIG_REPO_USERNAME=your-github-username
CONFIG_REPO_TOKEN=github_pat_xxxxxxxxxxxxxxxx
